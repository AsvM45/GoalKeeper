<Window x:Class="ConfigUI.Views.FrictionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        AllowsTransparency="True"
        Background="#CC000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Title="GoalKeeper – Mindful Moment">

    <Grid>
        <Border Width="480" Height="440"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                CornerRadius="16"
                md:ElevationAssist.Elevation="Dp8">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Ellipse x:Name="BreathCircle" Grid.Row="0"
                         Width="64" Height="64"
                         HorizontalAlignment="Center"
                         Fill="{DynamicResource MaterialDesign.Brush.Primary}">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Width"
                                                     From="48" To="72" Duration="0:0:2"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                     From="48" To="72" Duration="0:0:2"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.6" To="1.0" Duration="0:0:2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="13" Opacity="0.7"
                               Text="You tried to open"/>
                    <TextBlock x:Name="AppLabel"
                               HorizontalAlignment="Center"
                               FontSize="22" FontWeight="Bold"
                               Margin="0,4,0,0"/>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="14" Opacity="0.6"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Take a breath. Is this really important right now?"/>
                </StackPanel>

                <!-- Cognitive mission task -->
                <Border Grid.Row="2" CornerRadius="8" Padding="14" Margin="0,16,0,0"
                        Background="#18000000">
                    <StackPanel>
                        <TextBlock x:Name="MissionLabel"
                                   Text="Mission"
                                   FontSize="11" Opacity="0.5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MissionTaskLabel"
                                   FontSize="15" FontWeight="Medium"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock x:Name="CountdownLabel"
                               FontSize="56" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    <TextBlock Text="seconds remaining"
                               HorizontalAlignment="Center"
                               FontSize="12" Opacity="0.5"/>
                    <TextBlock x:Name="ProbabilityLabel"
                               HorizontalAlignment="Center"
                               FontSize="12" Opacity="0.55"
                               Margin="0,8,0,0"
                               TextAlignment="Center"/>
                </StackPanel>

                <Button Grid.Row="4"
                        x:Name="CancelButton"
                        Content="Cancel – Close It"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="CancelButton_Click"
                        Margin="0,8,0,8"/>

                <!-- Pause-before-Pause: hidden until intentional 1–2s delay after countdown -->
                <Button Grid.Row="5"
                        x:Name="UnlockButton"
                        Content="Unlock"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="Collapsed"
                        IsEnabled="False"
                        Click="UnlockButton_Click"
                        Margin="0,0,0,4"/>

                <TextBlock Grid.Row="6" x:Name="PauseBeforePauseLabel"
                           Text="Preparing unlock…"
                           HorizontalAlignment="Center"
                           FontSize="11" Opacity="0.4"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
